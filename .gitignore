# =============================================================================
# ORM_Skyway Automation — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Per-project generated artifacts (created when the tool runs)
# These live in the user's service project directory, not the tool repo.
# Listed here as a safety net in case someone runs the tool from the repo root.
# -----------------------------------------------------------------------------

# Compiled Java classes
bin/

# ORM spec files — contain DB credentials, do not commit
config/*.jdx
config/*.revjdx
config/*.config

# JDBC driver JAR copies
config/*.jar

# Temporary helper directory (cleaned up automatically after each run)
.tmp_helper/

# Docker mode (softwaretree/orm_skyway): one-time license acceptance marker
# and extracted JDX SDK sandbox -- both machine/run-specific
.orm_skyway_license_accepted
jdx_sandbox/

# curl output log
curl.log

# Java sources list (generated by compile step)
sources.txt

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# -----------------------------------------------------------------------------
# OS and editor artifacts
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.iml
# -----------------------------------------------------------------------------
# Other non-core files created for backups
# -----------------------------------------------------------------------------
*.zip

# -----------------------------------------------------------------------------
# Internal release scripts (not needed to build or run this project)
# -----------------------------------------------------------------------------
docker/publish.cmd
docker/publish.sh
